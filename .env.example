# Application
APP_NAME=treichville_exchange
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=treichville_exchange=debug,tower_http=debug,sqlx=debug

# Database
DATABASE_URL=postgres://treichville_user:changeThisPassword123!@localhost:5432/treichville_exchange
DATABASE_MAX_CONNECTIONS=100
DATABASE_MIN_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=50

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_ACCESS_TOKEN_EXPIRY=900 # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRY=604800 # 7 days in seconds
JWT_ISSUER=treichville-exchange

# Security
ARGON2_SALT=your-salt-here-change-in-production
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Binance API
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Mobile Money APIs
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_MONEY_CLIENT_ID=your-client-id
ORANGE_MONEY_CLIENT_SECRET=your-client-secret
ORANGE_MONEY_MERCHANT_KEY=your-merchant-key

WAVE_API_URL=https://api.wave.com/v1
WAVE_API_KEY=your-wave-api-key
WAVE_WEBHOOK_SECRET=your-wave-webhook-secret

MTN_MOMO_API_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your-subscription-key
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/webhooks/mtn

# Transaction Settings
DEFAULT_TRANSACTION_TIMEOUT_MINUTES=15
MAX_TRANSACTION_AMOUNT_XOF=10000000
MIN_TRANSACTION_AMOUNT_XOF=1000
DEFAULT_FEE_PERCENTAGE=0.5

# KYC Limits (in XOF)
KYC_LEVEL_0_DAILY_LIMIT=50000
KYC_LEVEL_0_MONTHLY_LIMIT=500000
KYC_LEVEL_1_DAILY_LIMIT=500000
KYC_LEVEL_1_MONTHLY_LIMIT=5000000
KYC_LEVEL_2_DAILY_LIMIT=5000000
KYC_LEVEL_2_MONTHLY_LIMIT=50000000

# SMS Provider (for OTP)
SMS_PROVIDER=twilio # or orange_sms
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@treichville-exchange.com

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=treichville-exchange
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Feature Flags
ENABLE_CRYPTO_TRADING=true
ENABLE_WEBSOCKET=true
ENABLE_SMS_OTP=false
ENABLE_2FA=true
ENABLE_RATE_LIMITING=true

# Cache TTL (in seconds)
RATE_CACHE_TTL=30
USER_SESSION_TTL=3600
TRANSACTION_LOCK_TTL=900

# WebSocket
WS_MAX_CONNECTIONS=10000
WS_PING_INTERVAL=30
WS_MAX_MESSAGE_SIZE=65536

# File Storage (for KYC documents)
STORAGE_TYPE=local # or s3
STORAGE_PATH=/var/lib/treichville-exchange/uploads
AWS_S3_BUCKET=treichville-kyc-docs
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Idempotency
IDEMPOTENCY_KEY_TTL=86400 # 24 hours

# Audit & Compliance
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=/var/log/treichville-exchange/audit.log
SUSPICIOUS_AMOUNT_THRESHOLD_XOF=1000000
MAX_TRANSACTIONS_PER_DAY=50

# Admin Settings
ADMIN_EMAILS=admin@treichville-exchange.com
SUPER_ADMIN_PHONE=+2250000000000